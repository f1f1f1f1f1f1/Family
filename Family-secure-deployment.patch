diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index bb348aa..a149e7a 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -19,6 +19,33 @@ jobs:
 
       - run: npm ci
 
+      - name: Audit production dependencies (high and critical)
+        run: npm audit --omit=dev --audit-level=high
+
+      # The production audit omits build tools, so gate Vite's advisory floor separately.
+      - name: Verify patched Vite dev dependency
+        run: |
+          node --input-type=commonjs <<'NODE'
+          const declared = require('./package.json').devDependencies.vite;
+          const installed = require('vite/package.json').version;
+          const lowerBound = typeof declared === 'string'
+            ? /^(?:\^|~)?(\d+\.\d+\.\d+)$/.exec(declared)?.[1]
+            : null;
+          function atLeast(version, minimum) {
+            if (!/^\d+\.\d+\.\d+$/.test(version ?? '')) return false;
+            const parts = version.split('.').map(Number);
+            const floor = minimum.split('.').map(Number);
+            for (let index = 0; index < 3; index++) {
+              if (parts[index] > floor[index]) return true;
+              if (parts[index] < floor[index]) return false;
+            }
+            return true;
+          }
+          if (!atLeast(lowerBound, '6.4.3') || !atLeast(installed, '6.4.3')) {
+            throw new Error(`Vite must declare and install >=6.4.3; declared ${declared}, installed ${installed}`);
+          }
+          NODE
+
       - name: Type check
         run: npx tsc --noEmit
 
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index c3c77ae..c65d3e6 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -4,16 +4,22 @@ on:
   push:
     branches: [main]
 
-permissions:
-  contents: write
-  issues: write
-  pull-requests: write
+concurrency:
+  group: family-release
+  cancel-in-progress: false
 
-# No image to publish: config.yaml has no `image:` line, so Home Assistant
-# builds the add-on itself from the Dockerfile (ci.yml checks that it builds).
+# The HA add-on still builds from the repository root (config.yaml has no
+# image:). GHCR is a separate, versioned standalone distribution.
 jobs:
   release:
     runs-on: ubuntu-latest
+    permissions:
+      contents: write
+      issues: write
+      pull-requests: write
+    outputs:
+      tag: ${{ steps.version.outputs.tag }}
+      version: ${{ steps.version.outputs.version }}
     steps:
       - uses: actions/checkout@v4
         with:
@@ -26,7 +32,118 @@ jobs:
 
       - run: npm ci
 
+      - name: Record pre-release commit
+        id: before
+        run: echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
+
       - name: Release
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: npx semantic-release
+
+      # A tag pushed by GITHUB_TOKEN will not trigger another workflow. Capture
+      # the tag created in this run so the following jobs publish it here.
+      - name: Identify new release
+        id: version
+        env:
+          START_SHA: ${{ steps.before.outputs.sha }}
+        run: |
+          if [ "$(git rev-parse HEAD)" = "$START_SHA" ]; then
+            echo "No new semantic-release version; no image to publish."
+            exit 0
+          fi
+          version=$(sed -n 's/^version: "\(.*\)"/\1/p' config.yaml)
+          if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
+            echo "::error::Invalid released version in config.yaml"
+            exit 1
+          fi
+          tag="v$version"
+          if ! git show-ref --verify --quiet "refs/tags/$tag" ||
+             [ "$(git rev-list -n 1 "refs/tags/$tag")" != "$(git rev-parse HEAD)" ]; then
+            echo "::error::Release tag does not point to the new release commit"
+            exit 1
+          fi
+          echo "tag=$tag" >> "$GITHUB_OUTPUT"
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+
+  publish:
+    needs: release
+    if: needs.release.outputs.tag != ''
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      packages: write
+      id-token: write
+      attestations: write
+      artifact-metadata: write
+    env:
+      IMAGE: ghcr.io/f1f1f1f1f1f1/family
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ needs.release.outputs.tag }}
+
+      - name: Verify release source
+        id: source
+        env:
+          RELEASE_TAG: ${{ needs.release.outputs.tag }}
+          RELEASE_VERSION: ${{ needs.release.outputs.version }}
+        run: |
+          test "$(git describe --tags --exact-match HEAD)" = "$RELEASE_TAG"
+          grep -Fx "version: \"$RELEASE_VERSION\"" config.yaml
+          echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
+
+      - uses: docker/setup-qemu-action@v3
+      - uses: docker/setup-buildx-action@v3
+      - uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Refuse to overwrite a published version
+        env:
+          RELEASE_TAG: ${{ needs.release.outputs.tag }}
+          IMAGE_TAG: ${{ env.IMAGE }}:${{ needs.release.outputs.tag }}
+        run: |
+          # buildx inspect resolves multi-platform manifest lists as well as
+          # ordinary manifests. Never republish even after a failed signing
+          # run; the version tag remains immutable.
+          if result=$(docker buildx imagetools inspect "$IMAGE_TAG" 2>&1); then
+            echo "::error::$IMAGE_TAG already exists; release tags are immutable"
+            exit 1
+          fi
+          if ! grep -Eiq 'manifest unknown|manifest .*not found|manifest.*404|not found: ghcr.io/.*/manifests/|404 Not Found|response status code 404' <<< "$result"; then
+            echo "::error::Could not verify that $IMAGE_TAG is unused"
+            printf '%s\n' "$result"
+            exit 1
+          fi
+
+      - name: Build and publish standalone image
+        id: build
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          platforms: linux/amd64,linux/arm64,linux/arm/v7
+          push: true
+          tags: ${{ env.IMAGE }}:${{ needs.release.outputs.tag }}
+          labels: |
+            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
+            org.opencontainers.image.revision=${{ steps.source.outputs.sha }}
+            org.opencontainers.image.version=${{ needs.release.outputs.version }}
+          provenance: mode=max
+
+      - uses: sigstore/cosign-installer@v4.1.0
+
+      - name: Sign published image digest (keyless)
+        env:
+          DIGEST: ${{ steps.build.outputs.digest }}
+        run: cosign sign --yes "$IMAGE@$DIGEST"
+
+      - name: Attest build provenance
+        uses: actions/attest@v4
+        with:
+          subject-name: ${{ env.IMAGE }}
+          subject-digest: ${{ steps.build.outputs.digest }}
+          push-to-registry: true
+          create-storage-record: false
